/* fifatui — terminal styles */

Screen {
    layers: base overlay;
    background: $surface;
}

/* ---- Match list ---- */
#list-title {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
    text-style: bold;
}
#list-status {
    dock: top;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
#match-table {
    height: 1fr;
}

/* ---- Watch view ---- */
#topbar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
    text-style: bold;
}
#statusbar {
    dock: top;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

ScoreBoard {
    height: auto;
    padding: 1 2 0 2;
}
#score-row {
    height: auto;
    align: center middle;
}
#home-panel, #away-panel {
    width: 1fr;
    height: auto;
    content-align: center middle;
}
#score-digits {
    width: auto;
    min-width: 18;
    content-align: center middle;
    color: $text;
}
#status-line {
    height: 1;
    content-align: center middle;
    color: $text-muted;
}

StatBars {
    height: auto;
    padding: 1 4;
}

EventFeed {
    height: 1fr;
    padding: 0 2;
    border-top: round $panel;
}
#event-list {
    height: auto;
}

/* ---- Goal celebration overlay ---- */
GoalCelebration {
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    background: black;
}
