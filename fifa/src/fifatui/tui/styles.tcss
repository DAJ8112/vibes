/* fifatui — stadium scoreboard theme */

Screen {
    layers: base overlay;
    background: $surface;
}

Footer {
    background: $panel;
}

/* ---- Match list ---- */
#list-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $amber;
    text-style: bold;
}
#list-status {
    height: 1;
    padding: 0 1;
    color: $amber-dim;
}
#match-table {
    height: 1fr;
}
#match-list {
    height: 1fr;
    background: $surface;
    border: none;
    padding: 0 1;
}
#match-list > .option-list--option-highlighted {
    background: $unlit;
    text-style: none;
}
#match-list:focus > .option-list--option-highlighted {
    background: $unlit;
    text-style: none;
}
#match-list > .option-list--option-disabled {
    color: $amber-dim;
}

/* ---- Watch view ---- */
#topbar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $amber;
    text-style: bold;
}
#statusbar {
    height: 1;
    padding: 0 1;
    color: $amber-dim;
}

ScoreBoard {
    height: auto;
    padding: 1 2 0 2;
}
#score-row {
    height: auto;
    align: center middle;
}
#home-panel, #away-panel {
    width: 1fr;
    height: auto;
    content-align: center middle;
}
#score-digits {
    width: auto;
    min-width: 18;
    content-align: center middle;
    color: $amber;
}
#status-line {
    height: 1;
    content-align: center middle;
    color: $amber-dim;
}

StatBars {
    height: auto;
    padding: 1 4;
}

EventFeed {
    height: 1fr;
    padding: 0 2;
    border-top: round $unlit;
}
#event-list {
    height: auto;
}

/* ---- Score ticker (other live matches) ---- */
ScoreTicker {
    height: 1;
    background: $panel;
    color: $amber-dim;
}

/* ---- Goal celebration overlay ---- */
GoalCelebration {
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
    background: $surface;
}

/* ---- Event banner strip (cards, subs, kickoff/HT/FT) ---- */
EventBanner {
    display: none;
    layer: overlay;
    width: 100%;
    height: 7;
    margin-top: 9;
    background: $panel;
    content-align: center middle;
}
