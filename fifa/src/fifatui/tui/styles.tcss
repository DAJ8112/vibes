/* fifatui — broadcast console theme */

Screen {
    layers: base overlay;
    background: $surface;
}

Footer {
    background: $panel;
}

/* ---- Match list ---- */
#list-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $accent;
    text-style: bold;
}
#list-status {
    height: 1;
    padding: 0 1;
    color: $dim;
}
#match-table {
    height: 1fr;
}
#match-list {
    height: 1fr;
    background: $surface;
    border: none;
    padding: 0 1;
}
#match-list > .option-list--option-highlighted {
    background: $unlit;
    text-style: none;
}
#match-list:focus > .option-list--option-highlighted {
    background: $unlit;
    text-style: none;
}
#match-list > .option-list--option-disabled {
    color: $dim;
}

/* ---- Watch view: scoreboard (top 40%) ---- */
ScoreBoard {
    height: 40%;
    min-height: 17;
    border: solid $border;
    padding: 0 2;
}
#board-header {
    height: 1;
    color: $dim;
}
#score-row {
    height: 1fr;
    align: center middle;
}
#home-panel, #away-panel {
    width: 1fr;
    height: auto;
    content-align: center middle;
}
#score-digits {
    width: auto;
    min-width: 18;
    content-align: center middle;
    color: $accent;
}
#status-line {
    height: 1;
    content-align: center middle;
    color: $accent;
}
#board-footer {
    height: 1;
    content-align: center middle;
    color: $dim;
}

/* ---- Penalty shootout tracker (inside the scoreboard) ---- */
ShootoutPanel {
    display: none;
    height: auto;
    padding: 0 4;
}

/* ---- Watch view: bottom row (side panel + console) ---- */
#watch-bottom {
    height: 1fr;
}

SidePanel {
    width: 35%;
    height: 1fr;
    border: solid $border;
    border-top: none;
    layout: vertical;
}
.panel-header {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $accent;
    text-style: bold;
}
EventFeed {
    height: 1fr;
    padding: 0 1;
}
#event-list {
    height: auto;
}
StatBars {
    height: auto;
    padding: 1 1;
}

/* ---- Watch view: interactive console ---- */
ConsolePanel {
    width: 1fr;
    height: 1fr;
    border: solid $border;
    border-top: none;
    border-left: none;
    layout: vertical;
}
#console-log {
    height: 1fr;
    padding: 1 1;
    background: $surface;
    scrollbar-size-vertical: 1;
}
#console-prompt-row {
    height: 3;
    padding: 0 1;
    background: $panel;
}
#console-sigil {
    width: auto;
    height: 3;
    content-align: left middle;
    color: $accent;
    text-style: bold;
    padding: 0 1 0 0;
}
#console-input {
    width: 1fr;
    height: 3;
    border: none;
    background: $panel;
    color: $fg;
    padding: 0;
}
#console-input:focus {
    border: none;
}

/* ---- Score ticker (other live matches) ---- */
ScoreTicker {
    height: 1;
    background: $panel;
    color: $dim;
}

/* ---- Goal celebration overlay ---- */
GoalCelebration {
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
    background: $surface;
}

/* ---- Event banner strip (cards, subs, kickoff/HT/FT) ---- */
EventBanner {
    display: none;
    layer: overlay;
    width: 100%;
    height: 7;
    margin-top: 9;
    background: $panel;
    content-align: center middle;
}
